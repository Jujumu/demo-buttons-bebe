[Unit]
Description=Buttons Bebe Job Processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/buttonsbebe/processor
ExecStart=/bin/bash -c 'exec "/opt/buttonsbebe/processor/.venv/bin/python" -m orchestrator'
Restart=always
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment="PYTHONPATH=/opt/buttonsbebe/processor:/opt/buttonsbebe/webhook/src"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bb-processor

[Install]
WantedBy=multi-user.target
