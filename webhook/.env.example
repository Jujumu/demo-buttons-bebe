# Webhook / console settings. Prefer the repo-root .env (see CONNECT.md).
# Copy only if you run this package standalone. Never commit a filled-in .env.

# ── Gorgias ──────────────────────────────────────────────
GORGIAS_SUBDOMAIN=
GORGIAS_API_EMAIL=
GORGIAS_API_KEY=

# ── Webhook security ──────────────────────────────────────
# HMAC shared secret — set this SAME value in Gorgias HTTP Integration
WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

# ── Queue / idempotency DB ────────────────────────────────
WEBHOOK_DB_PATH=./data/webhook.db

# ── Console login ─────────────────────────────────────────
CONSOLE_USERNAME=owner

# ── Shopify ──────────────────────────────────────────────
# Full store domain, e.g. your-store.myshopify.com
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_MUTATIONS_ENABLED=0

# ── Logging ──────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
