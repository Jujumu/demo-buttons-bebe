[Unit]
Description=Buttons Bebe processor heartbeat (dead-man's switch)
Documentation="file:///root/Buttonsbebe%20Agent/processor/heartbeat.sh"
After=network-online.target

[Service]
Type=oneshot
# Quoted because the path contains a space.
ExecStart=/bin/bash "/root/Buttonsbebe Agent/processor/heartbeat.sh"
TimeoutStartSec=60

# Same WhatsApp credentials the processor uses. Keeping this as a separate
# drop-in (rather than inlining the secret) means rotating the secret is a
# one-file change. Create /etc/systemd/system/buttonsbebe-heartbeat.service.d/whatsapp.conf
# with the same two Environment= lines as the processor's drop-in.
EnvironmentFile=-/root/Buttonsbebe Agent/.env

# The alert de-dup state file must persist between firings — do NOT add
# PrivateTmp=true here or every run will re-alert.
StateDirectory=buttonsbebe
Environment="HEARTBEAT_STATE_FILE=/var/lib/buttonsbebe/heartbeat.state"
# Own window, decoupled from the queue's PROCESSOR_STALE_MINUTES.
Environment="HEARTBEAT_STALE_MINUTES=10"
# EnvironmentFile= is merged AFTER Environment= regardless of order here,
# so anything the shared .env defines wins. Keep these two OUT of the .env.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bb-heartbeat
