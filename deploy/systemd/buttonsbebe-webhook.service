[Unit]
Description=Buttons Bebe webhook receiver (Gorgias -> job queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/buttonsbebe/webhook
Environment="PYTHONPATH=/opt/buttonsbebe/webhook/src"
ExecStart=/bin/bash -c 'exec "/opt/buttonsbebe/webhook/.venv/bin/uvicorn" bb_webhook.app:app --host 127.0.0.1 --port 8000'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
