# Local Cute Things demo profile only — not a buyer production shop.
# Copy to demo/.env and fill in sandbox credentials if you run the local demo.
# Do not point this file at a live merchant shop. See CONNECT.md for that.

DEMO_MODE=1
DEMO_SHOP_DOMAIN=yznyc1-ez.myshopify.com

# Shopify: read-only credentials for the Cute Things development store.
SHOPIFY_SHOP=yznyc1-ez.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_PRODUCT_QUERY=status:active
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Gorgias: localhost fixture service, never a live helpdesk.
GORGIAS_SUBDOMAIN=cute-things-demo
GORGIAS_API_EMAIL=demo-agent@example.com
GORGIAS_API_KEY=demo-only-local-key
GORGIAS_BASE_URL=http://127.0.0.1:8190

# Redo: a separate demo store connection, if return/refund scenarios are needed.
REDO_API_KEY=
REDO_STORE_ID=

# Local demo runtime state must not share the production queue database.
WEBHOOK_DB_PATH=./data/cute-things-demo-webhook.db
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8100
DEMO_CONSOLE_PORT=8101
WEBHOOK_SECRET=demo-only-webhook-secret-change-me
DASHBOARD_RESULT_URL=http://127.0.0.1:8100/dashboard/api/results
FEEDBACK_KB_ROOT=./demo/data/kb
KB_MCP_URL=http://127.0.0.1:8177/mcp
KB_MCP_PORT=8177
REDO_MCP_PORT=8178
GORGIAS_MCP_PORT=8179
GORGIAS_MCP_TRANSPORT=streamable-http
DEMO_GORGIAS_PORT=8190
DEMO_GORGIAS_FIXTURES=./fixtures/gorgias.json
DEMO_GORGIAS_ACTION_LOG=./data/cute-things-demo-gorgias-actions.jsonl

# Deterministic local emulators: no network, credentials, or mutable state.
DEMO_FAKE_SERVICES=1
DEMO_KB_FIXTURES=./fixtures/kb.json
DEMO_REDO_FIXTURES=./fixtures/redo.json
DEMO_WHATSAPP_FIXTURES=./fixtures/whatsapp.json
KB_MCP_TRANSPORT=streamable-http
REDO_MCP_TRANSPORT=streamable-http
DEMO_WHATSAPP_PORT=8185
DEMO_WA_BASE_PATH=/connect-whatsapp/demo
DEMO_WA_SEND_SECRET=demo-only-whatsapp-send-secret
DEMO_WA_OUTBOX=./data/cute-things-demo-whatsapp-outbox.jsonl

# Local-only alert sink used by processor/whatsapp_notifier.py.
WHATSAPP_SEND_URL=http://127.0.0.1:8185/connect-whatsapp/demo/send
WA_SEND_SECRET=demo-only-whatsapp-send-secret
WHATSAPP_TICKET_BASE_URL=http://127.0.0.1:8100/demo/tickets

# Keep the agent read-only. Human console actions remain the only write path.
SHOPIFY_MUTATIONS_ENABLED=0
HERMES_TOOLSETS=buttonsbebe_kb,buttonsbebe_redo,buttonsbebe_gorgias
HERMES_PROFILE=cutethingsdemo
HERMES_REWRITE_TOOLSETS=todo
HERMES_IGNORE_RULES=1
# Use `hermes` on PATH. Uncomment only if you need an override.
# HERMES_BIN=hermes
# HERMES_OS_HOME=$HOME
# HERMES_PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
SHOPIFY_STORE_DOMAIN=yznyc1-ez.myshopify.com
SUPPORT_STORE_NAME="Cute Things"
