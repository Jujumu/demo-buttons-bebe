[Unit]
Description=Buttons Bebe WhatsApp connect (QR pairing + Hermes bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/buttonsbebe/whatsapp-connect
EnvironmentFile="/opt/buttonsbebe/whatsapp-connect/.env"
Environment=WA_PORT=8085
Environment=WA_AUTH_DIR=/opt/buttonsbebe/whatsapp-connect/auth
Environment=HERMES_BIN=__HERMES_BIN__
ExecStart=/bin/bash -c 'exec __NODE__ "/opt/buttonsbebe/whatsapp-connect/server.js"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
