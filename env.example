# Buttons Bebe Support — credentials & settings
# Copy to .env and fill in YOUR values. Never commit a filled-in .env.
# Shopify connect steps: CONNECT.md

# ── Gorgias (help desk) — Basic Auth ─────────────────────────────
# Bare subdomain only (the part before .gorgias.com). No production default.
GORGIAS_SUBDOMAIN=
GORGIAS_API_EMAIL=                       # Username from Gorgias > Settings > REST API
GORGIAS_API_KEY=                         # Password (API Key) from that same page

# ── Shopify — client-credentials grant (mints a 24h Admin API token) ─
# Full store domain, e.g. your-store.myshopify.com. Create a Dev Dashboard
# app, Release a version with scopes, Install it on the shop, then paste
# Client ID and Client secret here. See CONNECT.md.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# SHOPIFY_PRODUCT_QUERY=status:active     # "" = sync ALL products (incl. drafts)
# Keep store writes off unless a separately approved operation enables them.
SHOPIFY_MUTATIONS_ENABLED=0

# ── Console login ───────────────────────────────────────────────
CONSOLE_USERNAME=owner
# CONSOLE_PASSWORD_HASH=                 # PBKDF2 hash — never a plaintext password
# CONSOLE_SESSION_SECRET=                # long random signing secret

# ── Redo (returns) — Bearer token ───────────────────────────────
REDO_API_KEY=
REDO_STORE_ID=

# ── Webhook receiver (bb_webhook, port 8000) ────────────────────
WEBHOOK_SECRET=                          # HMAC shared secret (generate: openssl rand -hex 32)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000
WEBHOOK_DB_PATH=./data/webhook.db

# ── Processor / brain ───────────────────────────────────────────
KB_MCP_URL=http://127.0.0.1:8077/mcp
LLM_MODEL=glm-5.2
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=
# PROCESSOR_POLL_INTERVAL=2.0
# PROCESSOR_JOB_TIMEOUT=120
# PROCESSOR_MAX_RETRIES=3
# PROCESSOR_STALE_MINUTES=10
# PROCESSOR_HEARTBEAT_SECONDS=120

# ── Hermes ──────────────────────────────────────────────────────
# `hermes` must be on PATH. Override only if needed.
# HERMES_BIN=hermes
# HERMES_OS_HOME=$HOME
# HERMES_PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
# HERMES_TOOLSETS=buttonsbebe_kb,buttonsbebe_redo,buttonsbebe_gorgias
# HERMES_SKIP_APPROVAL=0

# ── Logging ─────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=INFO
